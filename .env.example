# Service role key – required for scholarship submissions + rate limiting. Keep secret!
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional – salt for hashed IPs in rate limits / submission dedup (defaults to a derived value).
# RATE_LIMIT_IP_SALT=

# Optional – OpenAI for discover page copy framing (falls back to templates without key).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Without these, submit opens the hosted Beehiiv form in a new tab instead.
# https://www.beehiiv.com/settings/api
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=
